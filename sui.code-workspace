{
  "folders": [
    {
      "path": "./packages/app",
      "name": "app",
    },
    {
      "path": "./packages/shared",
      "name": "shared",
    },
    {
      "path": ".",
      "name": "root",
    },
  ],
  "settings": {
    "eslint.useFlatConfig": true,
    "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "vue", "html"],
    "eslint.format.enable": true,
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
    },
    "css.validate": false,
    "less.validate": false,
    "scss.validate": false,
    "stylelint.validate": ["css", "less", "scss", "vue"],
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/node_modules": true,
      ".yarn": true,
      ".nx": true,
      ".husky": true,
      "**/@types": true,
      "**/dist": true,
      "**/storybook-static": true,
      "**/lint-staged*": true,
      "**/.cursor": true,
    },
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 7,
    "typescript.preferences.importModuleSpecifier": "non-relative",
    "i18n-ally.localesPaths": [],
    "typescript.tsdk": "root/node_modules/typescript/lib",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "tsconfig.json": "tsconfig.*.json, shims-*.d.ts",
      "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*",
      "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .prettier*, prettier*, .editorconfig, stylelint*, commitlint*, nx.json, .env.yarn",
    },
    "nxConsole.generateAiAgentRules": true,
  },
  "extensions": {
    "recommendations": ["Vue.volar", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "stylelint.vscode-stylelint"],
  },
}
