{
  "extends": "@khsura/shared/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@khsura/sui/*": ["../app/*"],
      "@khsura/storybook/*": ["./*"],
    }
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue",
    ".storybook/**/*.js",
    ".storybook/**/*.jsx",
    ".storybook/**/*.mjs",
    ".storybook/**/*.cjs",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".storybook/**/*.vue",
  ],
}