        "type": "{ item: T; }",
      },
      {
        "description": "Group row content, rendered when \`groupBy\` is set.",
        "name": "group",
        "type": "TableGroupSlotProps<T>",
      },
      {
        "description": "Header cell of one column; the key is \`header.\` followed by the column's \`value\`.",
        "name": "header.<column>",
        "pattern": "^header\\..+$",
        "type": "TableHeaderSlotProps",
      },
      {
        "description": "Body cell of one column; the key is \`item.\` followed by the column's \`value\`.",
        "name": "item.<column>",
        "pattern": "^item\\..+$",
        "type": "TableItemSlotProps<T>",
      },
      {
        "description": "Full-width row below an item, rendered when \`itemFooter\` is set and the item has that key.",
        "name": "itemFooter",
        "type": "TableItemFooterSlotProps<T>",
      },
      {
        "description": "Full-width row above an item, rendered when \`itemHeader\` is set and the item has that key.",
        "name": "itemHeader",
        "type": "TableItemHeaderSlotProps<T>",
      },
      {
        "description": "Label of the items-per-page selector in the pagination.",
        "name": "itemsPerPageLabel",
        "type": "any",
      },
      {
        "description": "Shown instead of the rows while \`loading\` is set and \`items\` is still empty.",
        "name": "loadingData",
        "type": "any",
      },
      {
        "description": "Shown instead of the rows when \`items\` is empty and not loading.",
        "name": "noData",
        "type": "any",
      },
    ],
  },
]
`;
