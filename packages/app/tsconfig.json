{
  "extends": "@khsura/shared/tsconfig.base.json",
  "compilerOptions": {
    "declarationDir": "@types",
    "paths": {
      "@/app/*": ["./*"]
    }
  },
  "include": [
    "**/*.js", 
    "**/*.mjs", 
    "**/*.ts", 
    "**/*.tsx", 
    "**/*.vue", 
    ".storybook/**/*.js",
    ".storybook/**/*.jsx",
    ".storybook/**/*.mjs",
    ".storybook/**/*.cjs",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".storybook/**/*.vue"
  ],
  "exclude": ["dist", "node_modules", "public", "@types"]
}
