  "author": "sura.kh <sura.kh@rakuten.com>",
  "license": "MIT",
  "scripts": {
    "g:vite": "cd $INIT_CWD && vite",
    "g:vitest": "cd $INIT_CWD && vitest",
    "g:vue-tsc": "cd $INIT_CWD && vue-tsc",
    "g:rimraf": "cd $INIT_CWD && rimraf",
    "g:tsc-alias": "cd $INIT_CWD && tsc-alias",
    "g:vite-node": "cd $INIT_CWD && vite-node",
