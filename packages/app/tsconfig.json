{
  "extends": "@khsura/shared/tsconfig.base.json",
  "compilerOptions": {
    "declarationDir": "@types",
    "paths": {
      "@khsura/sui/*": ["./*"]
    }
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue"
  ],
  "exclude": ["dist", "node_modules", "public", "@types"]
}