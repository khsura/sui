{
  "name": "@khsura/sui",
  "version": "1.2.4",
  "type": "module",
  "scripts": {
    "prebuild": "yarn g:rimraf dist && yarn g:rimraf @types",
    "type-check": "yarn g:vue-tsc --build && yarn g:tsc-alias",
    "build": "yarn prebuild && yarn type-check && yarn g:vite build && cp -R styles dist/styles",
    "eslint": "yarn g:eslint",
    "stylelint": "yarn g:stylelint ./**/*.{vue,css,scss}",
    "test": "yarn g:vitest run",
    "release": "yarn g:publish",
    "storybook:dev": "yarn storybook dev -p 6006",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "files": [
    "dist",
    "@types"
  ],
  "main": "./dist/s-ui.umd.cjs",
  "module": "./dist/s-ui.js",
  "types": "./@types/index.d.ts",
  "exports": {
    "./style.css": "./dist/s-ui.css",
    "./helpers.scss": "./dist/styles/_helpers.scss",
    ".": {
      "import": {
        "types": "./@types/index.d.ts",
        "default": "./dist/s-ui.js"
      },
      "require": {
        "types": "./@types/index.d.ts",
        "default": "./dist/s-ui.umd.cjs"
      }
    }
  },
  "dependencies": {
    "@vueuse/components": "^13.0.0",
    "@vueuse/core": "^13.0.0",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@storybook/addon-actions": "^8.6.11",
    "@storybook/addon-docs": "^8.6.11",
    "@storybook/addon-essentials": "^8.6.11",
    "@storybook/addon-interactions": "^8.6.11",
    "@storybook/addon-links": "^8.6.11",
    "@storybook/manager-api": "^8.6.11",
    "@storybook/test": "^8.6.11",
    "@storybook/theming": "^8.6.11",
    "@storybook/vue3": "^8.6.11",
    "@storybook/vue3-vite": "^8.6.11",
    "@vitest/eslint-plugin": "^1.1.38",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "eslint-plugin-oxlint": "^0.16.3",
    "storybook": "^8.6.11",
    "storybook-dark-mode": "^4.0.2"
  }
}
