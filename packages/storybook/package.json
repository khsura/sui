{
  "name": "@sui/storybook",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "yarn g:rimraf ./storybook-static && yarn g:rimraf ./@types",
    "build": "yarn prebuild && yarn g:tsc && yarn storybook build",
    "eslint": "yarn g:eslint",
    "stylelint": "yarn g:stylelint ./**/*.{vue,css,scss}",
    "storybook": "storybook dev --port 6006",
    "start": "http-server ./storybook-static -p 6006"
  },
  "devDependencies": {
    "@storybook/addon-actions": "^8.0.9",
    "@storybook/addon-docs": "^8.0.9",
    "@storybook/addon-essentials": "^8.0.9",
    "@storybook/addon-interactions": "^8.0.9",
    "@storybook/addon-links": "^8.0.9",
    "@storybook/manager-api": "^8.0.9",
    "@storybook/testing-library": "^0.2.2",
    "@storybook/theming": "^8.0.9",
    "@storybook/vue3": "^8.0.9",
    "@storybook/vue3-vite": "^8.0.9",
    "http-server": "^14.1.1",
    "storybook": "^8.0.9",
    "storybook-dark-mode": "^4.0.1"
  }
}
