    "eslint": "nx run-many --target=eslint --all",
    "stylelint": "nx run-many --target=stylelint --all",
    "release": "nx run-many --target=release --all",
    "test": "vitest --run",
    "postinstall": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable",
    "storybook": "yarn workspace @khsura/storybook run dev"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
