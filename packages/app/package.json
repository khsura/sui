{
  "name": "@khsura/sui",
  "version": "1.7.1",
  "type": "module",
  "scripts": {
    "prebuild": "yarn g:rimraf dist && yarn g:rimraf @types",
    "build:style": "yarn g:sass styles/index.scss dist/base.css",
    "build:type": "yarn g:vue-tsc -p tsconfig.build.json && yarn g:tsc-alias -p tsconfig.build.json",
    "build": "yarn prebuild && yarn build:type && yarn g:vite build && yarn build:style && cp -R styles dist/styles",
    "eslint": "yarn g:eslint",
    "stylelint": "yarn g:stylelint ./**/*.{vue,css,scss}",
    "test": "yarn g:vitest run",
    "release": "yarn g:publish"
  },
  "files": [
    "dist",
    "@types"
  ],
  "main": "./dist/s-ui.umd.cjs",
  "module": "./dist/s-ui.js",
  "types": "./@types/index.d.ts",
  "exports": {
    "./base.css": "./dist/base.css",
    "./style.css": "./dist/s-ui.css",
    "./style.scss": "./dist/styles/index.scss",
    "./helpers.scss": "./dist/styles/_helpers.scss",
    ".": {
      "import": {
        "types": "./@types/index.d.ts",
        "default": "./dist/s-ui.js"
      },
      "require": {
        "types": "./@types/index.d.ts",
        "default": "./dist/s-ui.umd.cjs"
      }
    }
  },
  "dependencies": {
    "@vueuse/components": "^13.0.0",
    "@vueuse/core": "^13.0.0",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "zod": "^3.24.2"
  }
}
