{
  "folders": [
    {
      "path": ".",
      "name": "root"
    },
    {
      "path": "./packages/app",
      "name": "app"
    },
    {
      "path": "./packages/storybook",
      "name": "storybook"
    },
    {
      "path": "./packages/shared",
      "name": "shared"
    },
  ],
  "settings": {
    "eslint.useFlatConfig": true,
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact",
      "vue",
      "html"
    ],
    "eslint.format.enable": true,
    "eslint.workingDirectories": [{"mode": "auto"}],
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    },
    "stylelint.stylelintPath": "./node_modules/stylelint",
    "stylelint.validate": [
      "css",
      "less",
      "postcss",
      "scss",
      "vue"
    ],
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/node_modules": true,
      ".nx": true,
      ".husky": true
    },
		"workbench.editor.limit.enabled": true,
		"workbench.editor.limit.value": 7,
    "typescript.preferences.importModuleSpecifier": "non-relative",
    "typescript.tsdk": "root/node_modules/typescript/lib"
  },
  "extensions": {
    "recommendations": ["Vue.volar", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "stylelint.vscode-stylelint"]
  }
}