{
  "name": "@khsura/storybook",
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "prebuild": "yarn g:rimraf ./storybook-static && yarn g:rimraf ./@types",
    "build": "yarn prebuild && yarn g:vue-tsc && yarn storybook build",
    "eslint": "yarn g:eslint",
    "stylelint": "yarn g:stylelint ./**/*.{vue,css,scss}",
    "dev": "storybook dev --port 6006",
    "start": "http-server ./storybook-static -p 6006"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.0.12",
    "@storybook/addon-links": "^9.0.12",
    "@storybook/vue3-vite": "^9.0.12",
    "eslint-plugin-storybook": "9.0.12",
    "http-server": "^14.1.1",
    "storybook": "^9.0.12"
  }
}
