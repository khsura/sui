{
  "name": "@khsura/sui",
  "version": "1.11.1",
  "type": "module",
  "scripts": {
    "prebuild": "yarn g:rimraf dist && yarn g:rimraf @types && yarn g:rimraf .claude-plugin && yarn g:rimraf sui-plugin",
    "build:style": "yarn g:sass styles/index.scss dist/base.css",
    "build:type": "yarn g:vue-tsc -p tsconfig.build.json && yarn g:tsc-alias -p tsconfig.build.json",
    "build:plugin": "cp -R ../../.claude-plugin . && cp -R ../../plugins/sui-plugin .",
    "build": "yarn prebuild && yarn build:type && yarn g:vite build && yarn build:style && cp -R styles dist/styles && yarn build:plugin",
    "lint": "yarn g:eslint",
    "stylelint": "yarn g:stylelint ./**/*.{vue,css,scss}",
    "test": "yarn g:vitest run --project unit",
    "test-storybook": "yarn g:vitest --project storybook",
    "release": "yarn g:publish",
    "storybook:dev": "storybook dev --port 6006",
    "storybook:build": "storybook build"
  },
  "files": [
    "dist",
    "@types",
    ".claude-plugin",
    "sui-plugin"
  ],
  "main": "./dist/s-ui.umd.cjs",
  "module": "./dist/s-ui.js",
  "types": "./@types/index.d.ts",
  "exports": {
    "./base.css": "./dist/base.css",
    "./style.css": "./dist/s-ui.css",
    "./style.scss": "./dist/styles/index.scss",
    "./helpers.scss": "./dist/styles/_helpers.scss",
    ".": {
      "import": {
        "types": "./@types/index.d.ts",
        "default": "./dist/s-ui.js"
      },
      "require": {
        "types": "./@types/index.d.ts",
        "default": "./dist/s-ui.umd.cjs"
      }
    }
  },
  "dependencies": {
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.3.0",
    "dayjs": "^1.11.21",
    "uuid": "^14.0.1",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/vue3-vite": "^10.4.6",
    "@types/lodash.merge": "^4.6.9",
    "@vitest/browser-playwright": "^4.1.9",
    "chokidar": "^5.0.0",
    "eslint-plugin-storybook": "10.4.6",
    "http-server": "^14.1.1",
    "lodash.merge": "^4.6.2",
    "playwright": "^1.61.1",
    "storybook": "^10.4.6",
    "vitest": "^4.1.9"
  }
}
